NATS_SERVERS=nats://nats:4222
MACHINE_ID=miniqubot
QUBOT_PORT=/dev/ttyUSB0
HOME_ON_STARTUP=true

# Optional. SDK 0.0.21 does not read these from the environment on its own.
# PUDA_NATS_CA=/path/to/ca.pem
# PUDA_E2E_KEY_FILE=/path/to/e2e.key

# Host CH340 has no unique serial number, so Compose maps this by-path node.
MINIQUBOT_HOST_DEVICE=/dev/serial/by-path/pci-0000:00:14.0-usb-0:9:1.0-port0
MINIQUBOT_DIALOUT_GID=20
